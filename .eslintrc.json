{
  "extends": [
    "airbnb-base",
    "prettier",
    "eslint:recommended",
    "plugin:node/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 2023,
    "requireForBlockBody": true
  },
  "parser": "@babel/eslint-parser",
  "env": {
    "commonjs": true,
    "node": true
  },
  "rules": {
    "arrow-body-style": ["error", "always"],
    "curly": ["error", "all"],
    "consistent-return": 0,
    "no-console": 0,
    "indent": 0,
    "linebreak-style": 0,
    "camelcase":"off"
  },
  "plugins": ["prettier"]
}
